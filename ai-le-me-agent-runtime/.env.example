APP_NAME=AiLeMe Agent Runtime
APP_ENV=dev
APP_PORT=8091
LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yuelao
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CHARSET=utf8mb4

MYSQL_READ_SHARED_CONFIG=true
MYSQL_ENABLE_RUNTIME_TABLES=true

THIRD_PARTY_PROVIDER_TABLE=sys_third_party_provider
THIRD_PARTY_CONFIG_TABLE=sys_third_party_config
THIRD_PARTY_ROUTE_TABLE=sys_third_party_route_rule
SYS_CONFIG_TABLE=sys_config

DEFAULT_AI_SERVICE_TYPE=ai
DEFAULT_AI_PROVIDER=openai_codex
DEFAULT_PERSONA_PROVIDER=persona_v2
DEFAULT_COMPANION_PROVIDER=companion_v1
LLM_MODEL_FALLBACK=
LLM_API_PROTOCOL=chat_completions
LLM_REQUEST_TIMEOUT=45
LLM_ENABLE_DEBUG_TRACE=false
LLM_PREFER_ENV_DEFAULT=true
LLM_DEFAULT_PROVIDER_CODE=openai
LLM_DEFAULT_PROFILE_CODE=gpt_5_4
LLM_DEFAULT_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_API_PROTOCOL=responses
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1600

WORKFLOW_ENGINE=langgraph
WORKFLOW_ENABLED=true
MEMORY_PRIMARY=mem0
MEMORY_SECONDARY=letta
GRAPH_PRIMARY=graphiti
GRAPH_SECONDARY=neo4j
SKILLS_REFERENCE=openclaw
SKILLS_ADAPTER_MODE=controlled_adapter

LOCAL_MEMORY_ENABLED=true
LOCAL_GRAPH_ENABLED=true
LOCAL_VECTOR_ENABLED=true
RETRIEVAL_MEMORY_FETCH_MULTIPLIER=3
RETRIEVAL_MEMORY_SCORE_THRESHOLD=0.12
RETRIEVAL_CANDIDATE_SCORE_THRESHOLD=0.1
RETRIEVAL_HYPOTHETICAL_ENABLED=true
RETRIEVAL_HYPOTHETICAL_PER_TEXT=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8008
CHROMA_COLLECTION_PREFIX=aileme_agent
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aileme-agent-dev
NEO4J_DATABASE=neo4j
