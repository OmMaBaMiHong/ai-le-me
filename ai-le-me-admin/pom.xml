    <parent>
        <artifactId>ai-le-me</artifactId>
        <groupId>org.aileme</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>ai-le-me-admin</artifactId>

    <description>
