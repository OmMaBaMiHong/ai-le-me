<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.aileme.shejiao.admin.dao.UserTagsDao">

    <!-- 根据用户ID查询标签ID列表 -->
    <select id="getTagIdsByUserId" resultType="java.lang.Integer">
        SELECT tag_id FROM user_tags WHERE user_id = #{userId}
    </select>

    <!-- 根据标签ID查询用户ID列表 -->
    <select id="getUserIdsByTagId" resultType="java.lang.Integer">
        SELECT user_id FROM user_tags WHERE tag_id = #{tagId}
    </select>

    <!-- 批量插入用户标签 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO user_tags (user_id, tag_id, source_type, weight, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.tagId}, #{item.sourceType}, #{item.weight}, #{item.createTime})
        </foreach>
    </insert>

    <!-- 删除用户的所有标签 -->
    <delete id="deleteByUserId">
        DELETE FROM user_tags WHERE user_id = #{userId}
    </delete>

</mapper>
