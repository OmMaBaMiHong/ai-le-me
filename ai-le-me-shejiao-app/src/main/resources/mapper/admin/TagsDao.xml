<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.aileme.shejiao.admin.dao.TagsDao">

    <!-- 根据分类查询标签 -->
    <select id="getByCategory" resultType="org.aileme.shejiao.domain.entity.admin.TagsEntity">
        SELECT * FROM tags
        WHERE tag_category = #{tagCategory}
          AND status = 1
        ORDER BY sort ASC
    </select>

    <!-- 根据标签ID列表批量查询 -->
    <select id="getBatchByIds" resultType="org.aileme.shejiao.domain.entity.admin.TagsEntity">
        SELECT * FROM tags WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 增加使用次数 -->
    <update id="increaseUsageCount">
        UPDATE tags SET usage_count = usage_count + 1 WHERE id = #{id}
    </update>

</mapper>
