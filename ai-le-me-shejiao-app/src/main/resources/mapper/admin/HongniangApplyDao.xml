<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.aileme.shejiao.admin.dao.HongniangApplyDao">

    <!-- 根据用户ID查询最新申请 -->
    <select id="getLatestByUserId" resultType="org.aileme.shejiao.domain.entity.admin.HongniangApplyEntity">
        SELECT * FROM hongniang_apply
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>
